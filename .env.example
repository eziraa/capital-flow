# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/capital_opportunities_tracker?schema=public"

# NextAuth (Auth.js) secret used to sign session JWTs and CSRF tokens.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of the app. Used by NextAuth for callback/redirect URLs.
NEXTAUTH_URL="http://localhost:3000"
